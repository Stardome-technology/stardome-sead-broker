# ── Stardome SEAD Broker Configuration ────────────────────────────────
# Copy this file to .env and fill in your values.
#
# Token modes (precedence order):
#   1. Per-request `auth_token` field in POST /attest body
#   2. SEAD_AUTH_SECRET env var (pre-generated org-wide token from edge-service API)
#   3. Auto-generate via gen-token binary (legacy — requires GEN_TOKEN_PATH + org keys)
#   4. No token (response omits `token` field)

# ── Stardome Hardware ──────────────────────────────────────────────────
# Host path to the stardome-client binary. The compose file uses this as
# the volume mount source, placing the binary at /opt/stardome/bin/stardome-client
# inside the container.
# Example: /home/bd/stardome-client/bin/stardome-client
# STARDOME_CLIENT_PATH=/opt/stardome/bin/stardome-client

# Serial port for the Stardome hardware module
# STARDOME_PORT=/dev/ttyUSB0

# Baud rate (default: 115200)
# STARDOME_BAUD=115200

# Timeout (ms) for hardware signing operations (default: 20000)
# STARDOME_TIMEOUT_MS=30000

# Scheme override (default: v1.0.0_0)
# STARDOME_SCHEME=v1.0.0_0

# ── SEAD Edge Service ───────────────────────────────────────────────────
# Base URL of the SEAD edge-service (POST /ingest endpoint).
# The edge stack runs on the same host; use host.docker.internal to reach
# it from inside the container (requires extra_hosts in compose).
# SEAD_EDGE_URL=https://host.docker.internal:30080

# Timeout (seconds) for SEAD ingest requests (default: 30)
# SEAD_INGEST_TIMEOUT_SEC=30

# ── Edge Identity ───────────────────────────────────────────────────────
# These are REQUIRED. The broker will fail-fast at startup if missing.
# EDGE_MODULE_ID=<hex module_id>
# EDGE_ORG_ID=<hex org_id>
# EDGE_ID=<hex edge_id>

# ── Token — Pre-generated (recommended) ──────────────────────────────────
# An org-wide auth token, generated with the gen-token CLI on a secure laptop
# (--org-id --org-signing-key --org-public-key --payload-file). The broker
# sends it as a Bearer header on POST /ingest — the gateway/edge requires a
# valid token on every ingest. (The old edge-service POST /auth/token HTTP
# endpoint is removed in the Go-gateway migration.)
# SEAD_AUTH_SECRET=<base64url token>

# ── Token — Auto-generation (optional, development only) ─────────────────
# Path to the gen-token C++ binary. Only needed if auto-generation is used.
# GEN_TOKEN_PATH=./bin/gen-token

# Org XMSS keys for auto-generation. Only needed if auto-generation is used.
# EDGE_ORG_SIGNING_KEY=<hex>
# EDGE_ORG_PUBLIC_KEY=<hex>

# Token TTL in seconds (default: 300). Only used for auto-generation.
# EDGE_TOKEN_TTL=300

# Timeout (seconds) for gen-token subprocess (default: 1800 = 30 min)
# GEN_TOKEN_TIMEOUT_SEC=1800

PAYLOADS_DIR=/home/ubuntu/payloads
SIGNATURES_DIR=/home/ubuntu/signatures
